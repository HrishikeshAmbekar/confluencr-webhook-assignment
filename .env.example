# Copy this file to .env for local development. Do not commit real credentials.
# In Supabase Dashboard: Connect > Session pooler, then copy the URI and set sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Keep these defaults for the assignment. Tests override them with short durations.
PROCESSING_DELAY_SECONDS=30
POLL_INTERVAL_SECONDS=30
CLAIM_TIMEOUT_SECONDS=90
MAX_CONCURRENT_JOBS=8
